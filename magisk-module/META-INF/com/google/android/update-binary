#!/sbin/sh
ui_print() { echo "$1"; }
ui_print "Installing RTL8812AU WiFi + RTL8761BU BT Magisk module...";
ui_print " ";

# Create directories
mkdir -p /vendor/lib/modules /lib/firmware/rtl_bt /lib/firmware/rtlwifi /etc/modprobe.d /etc/modules-load.d

# Copy modules (if they exist in the ZIP)
mkdir -p /tmp/update/bin
unzip -o "$ZIPFILE" "modules/*" -d /tmp/update/bin/ 2>/dev/null || true

# Copy WiFi modules
cp -f /tmp/update/bin/modules/rtw88_usb.ko /vendor/lib/modules/rtw88_usb.ko 2>/dev/null || true
cp -f /tmp/update/bin/modules/rtw88.ko /vendor/lib/modules/rtw88.ko 2>/dev/null || true

# Copy BT modules
cp -f /tmp/update/bin/modules/btusb.ko /vendor/lib/modules/btusb.ko 2>/dev/null || true
cp -f /tmp/update/bin/modules/hci_uart_rtl.ko /vendor/lib/modules/hci_uart_rtl.ko 2>/dev/null || true

# Copy firmware
cp -f /tmp/update/bin/firmware/* /lib/firmware/rtl_bt/ 2>/dev/null || true
cp -f /tmp/update/bin/firmware/* /lib/firmware/rtlwifi/ 2>/dev/null || true

# Set permissions
chmod 644 /vendor/lib/modules/*.ko 2>/dev/null || true
chmod 644 /lib/firmware/rtl_bt/* 2>/dev/null || true
chmod 644 /lib/firmware/rtlwifi/* 2>/dev/null || true
chmod 666 /dev/bus/usb/*/* 2>/dev/null || true
chmod 666 /dev/hci* 2>/dev/null || true

# Run post-finit
sh /vendor/post-finit.sh 2>/dev/null || true
sh /data/data/com.termux/files/home/bin/parrot-hw mon-up 2>/dev/null || true

ui_print "Module installed successfully!";
