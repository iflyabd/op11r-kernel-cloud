# Additive-only fragment for OP11r stock 5.10.236 (base: device-5.10.236.config)
# Verified against msm-kernel @ c6939a66 + common @ 5b5ead1 (2026-09-15).
# DWA-185 0bda:b812 = RTL8822B: NO in-tree support on 5.10 (rtw88 has no USB,
# rtl8xxxu covers only 8723AU/8188CU/8191CU/8192CU). WiFi via out-of-tree
# drivers-out/rtl88x2bu-cilynx (b812 confirmed in usb_intf.c). CFG80211 stays
# for the out-of-tree driver. Internal qca6490 uses vendor CNSS (CFG80211=n
# stock) — untouched.

# --- in-tree cfg80211/mac80211 for out-of-tree 88x2bu + iw/wpa tools ---
CONFIG_CFG80211=y
CONFIG_CFG80211_DEBUGFS=y
CONFIG_CFG80211_WEXT=y
CONFIG_MAC80211=y
CONFIG_MAC80211_MESH=y
CONFIG_MAC80211_LEDS=y
CONFIG_WIRELESS_EXT=y
CONFIG_WEXT_CORE=y
CONFIG_WEXT_PROC=y

# --- Bluetooth USB+UART RTL (UGREEN CM748). All symbols verified present. ---
CONFIG_BT_BNEP=m
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIBTUSB_RTL=y
CONFIG_BT_HCIUART_RTL=y

# --- USB serial helper: NOT needed (BT CM748 uses btusb; stock USB_SERIAL=n) ---

# --- Netfilter extras stock lacks (NAT/pentest). Base NETFILTER already y. ---
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNMARK=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_REDIRECT=y
CONFIG_IP_NF_TARGET_LOG=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IPV6_NF_IPTABLES=y
CONFIG_IPV6_NF_NAT=y

# --- MediaTek MT7601U USB (148f:7601, 802.11n WLAN stick, in-tree 5.10) ---
# Depends on MAC80211+USB (already y). =m keeps Image size + vermagic stable.
# Firmware mt7601u.bin ships via Magisk module lib/firmware/, not EXTRA_FIRMWARE.
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT7601U=m

# --- Modules + firmware loading (stock MODULES=y, FW_LOADER=y already) ---
CONFIG_MODULE_UNLOAD=y
CONFIG_EXTRA_FIRMWARE="rtl_bt/rtl8761b_fw.bin rtl_bt/rtl8761b_config.bin"

# --- Version string: reproduce stock EXACTLY for vendor_dlkm vermagic compat ---
# Stock: 5.10.236-android12-9-o-g74d132f4467a (LOCALVERSION="" + AUTO=y + CI scm).
# Repro: LOCALVERSION="-android12-9-o-g74d132f4467a" + LOCALVERSION_AUTO=n.
# BUILD_SALT is "" in stock — no salt divergence. uname -r identical to stock.

# --- MUST-KEEP guard (apply-config.sh aborts if any becomes n/missing) ---
# CONFIG_DM_VERITY=y CONFIG_SECURITY_SELINUX=y CONFIG_BT=y CONFIG_USB_DWC3=y
# CONFIG_USB_DWC3_QCOM=y CONFIG_TYPEC=y CONFIG_MMC=y CONFIG_THERMAL=y

# --- Hardening parity (stock has CFI+SCS+Full-LTO; needs clang+LLVM=1 at config) ---
# Resolved post-hoc via scripts/config (choice needs LLVM=1 visible):
# CONFIG_LTO_CLANG_FULL=y, CONFIG_CFI_CLANG=y, CONFIG_SHADOW_CALL_STACK=y
# NOTE: vendor_dlkm (377 modules) reference __cfi_check -> non-CFI kernel
# would leave internal WiFi/audio/camera unloadable. Never ship non-CFI.
